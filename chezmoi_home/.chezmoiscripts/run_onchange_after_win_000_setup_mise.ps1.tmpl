{{ if eq .chezmoi.os "windows" }}
# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

{{ template "ps1/bootstrap-common.ps1" . }}

Write-Header "Setting up mise tools"

# Verify mise is installed and resolve its full path (may contain spaces)
$miseBin = (Get-Command mise -CommandType Application -ErrorAction SilentlyContinue).Source
if (-not $miseBin) {
    Write-Error "mise is not installed or not in PATH"
    Write-Host "Please install mise first: https://mise.jdx.dev/getting-started.html" -ForegroundColor Red
    exit 1
}

Write-Host "mise version: $(& "$miseBin" --version)" -ForegroundColor Cyan

# Install all tools declared in ~/.config/mise/config.toml
& "$miseBin" install
if ($LASTEXITCODE -ne 0) {
    throw "mise install failed with exit code $LASTEXITCODE"
}

# Generate shims for non-shell processes (e.g. VS Code MCP servers).
& "$miseBin" reshim
if ($LASTEXITCODE -ne 0) {
    throw "mise reshim failed with exit code $LASTEXITCODE"
}

# Ensure mise shims directory is in the User PATH so that non-shell processes
# (e.g. VS Code MCP servers launched from a shortcut) can find mise-managed tools.
$shimsDir = "$env:LOCALAPPDATA\mise\shims"
if (Test-Path $shimsDir) {
    $userPath = [System.Environment]::GetEnvironmentVariable("Path", "User")
    if ($userPath -notlike "*$shimsDir*") {
        [System.Environment]::SetEnvironmentVariable("Path", "$shimsDir;$userPath", "User")
        Write-Host "[OK] Added mise shims to User PATH: $shimsDir" -ForegroundColor Green
    } else {
        Write-Host "[OK] mise shims already in User PATH" -ForegroundColor Green
    }
}

Write-Header "mise setup complete!"
Write-Host "Installed tools:"
& "$miseBin" list

{{ end }}
